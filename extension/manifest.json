{
  "manifest_version": 3,
  "name": "Denuncias RS · Autollenado",
  "version": "1.2.68",
  "update_url": "https://diegoarias-prog.github.io/denunciasrs-ext/update.xml",
  "description": "Rellena los formularios de denuncia (Facebook, Instagram, TikTok, WhatsApp, X, LinkedIn) con los datos de la marca seleccionada. Funciona en tu navegador con tu sesión.",
  "permissions": [
    "scripting",
    "storage",
    "unlimitedStorage",
    "activeTab",
    "debugger",
    "identity",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://*.instagram.com/*",
    "https://*.tiktok.com/*",
    "https://*.whatsapp.com/*",
    "https://*.linkedin.com/*",
    "https://twitter.com/*",
    "https://*.x.com/*",
    "https://support.google.com/*",
    "https://*.youtube.com/*",
    "https://support.github.com/*",
    "https://gmail.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Denuncias RS · Autollenado"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/*","https://*.instagram.com/*","https://*.tiktok.com/*",
        "https://*.whatsapp.com/*","https://*.linkedin.com/*","https://twitter.com/*",
        "https://*.x.com/*","https://support.google.com/*","https://*.youtube.com/*",
        "https://support.github.com/*"
      ],
      "js": ["captura_flotante.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "opciones.html",
  "commands": {
    "capturar_comprobante": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Capturar el formulario y guardarlo en el comprobante de la denuncia en curso"
    }
  },
  "key": ""
}
